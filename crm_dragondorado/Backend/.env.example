# Base de datos
DATABASE_URL="mysql://usuario:password@host:puerto/nombre_bd"

# JWT Secret (genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=tu_jwt_secret_seguro_aqui

# Entorno (development | production)
NODE_ENV=production

# Puerto del servidor
PORT=3000

# Configuración de Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail

# URL del frontend (dominio de producción)
FRONTEND_URL=https://tu-dominio-frontend.com

# URL pública del backend para pixel de apertura y enlaces medibles del email
PUBLIC_API_URL=https://tu-dominio-backend.com
BACKEND_URL=https://tu-dominio-backend.com

# El asistente funciona con reglas + base de datos sin una API externa.
# Para habilitar una futura capa generativa, el orquestador puede usar estas variables.
OPENAI_API_KEY=
CHATBOT_USE_OPENAI=false

# Mercado Pago - PRODUCCIÓN
# Obtén tus credenciales en: https://www.mercadopago.com.pe/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token-de-produccion
MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-de-produccion
MERCADOPAGO_NOTIFICATION_URL=https://tu-dominio-backend.com/api/mercadopago/webhook
